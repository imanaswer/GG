# ── Core Auth ─────────────────────────────────────────────────────────────────
AUTH_SECRET="your-random-32-char-secret-here"           # openssl rand -base64 32

# ── Google Sign-In (OAuth 2.0) ────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web).
# Authorized redirect URIs must include, per environment:
#   http://localhost:3000/api/auth/google/callback
#   https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID="...apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="..."                               # NEVER expose to client

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://www.gameground.net"        # or http://localhost:3000 for local dev. Must match a Google OAuth redirect URI exactly (incl. www).

# ── Claude AI ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."                          # Powers AI recommendations

# ── Database (Supabase / PostgreSQL) ─────────────────────────────────────────
# Pooled connection (via PgBouncer) — used by the running app at request time.
# Supabase → Project Settings → Database → Connection string → "Transaction" pooler.
DATABASE_URL="postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection — used by `prisma migrate` which needs a non-pooled socket.
# Supabase → Project Settings → Database → Connection string → "Direct connection".
DIRECT_URL="postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Payments (Razorpay) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_live_..."                          # Public — safe for client
RAZORPAY_KEY_SECRET="..."                               # NEVER expose to client
RAZORPAY_WEBHOOK_SECRET="..."                           # For verifying webhook signatures

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."                                 # From resend.com
FROM_EMAIL="hello@gameground.net"                       # Must be verified in Resend

# ── Images (Cloudinary) ───────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"    # Public — safe to expose
CLOUDINARY_API_KEY="..."                                # Server-side only
CLOUDINARY_API_SECRET="..."                             # NEVER expose to client

# ── Rate Limiting (Upstash Redis) ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://..."                    # From upstash.com
UPSTASH_REDIS_REST_TOKEN="..."                          # From upstash.com

# ── Error Monitoring (Sentry) — Optional but strongly recommended ──────────────
SENTRY_DSN="https://...@sentry.io/..."                 # Reserved: no Sentry SDK is wired yet; nothing reads this

# ── Analytics (PostHog) — Optional ────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY="phc_..."                      # From posthog.com

# ── Maps — Optional ───────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_KEY="AIza..."                  # For location picker

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD="..."                                    # Hashed password for admin dashboard

# ── Cron Security ─────────────────────────────────────────────────────────────
CRON_SECRET="..."                                       # Random string for cron auth

# ── Mobile Kill Switch — Optional ─────────────────────────────────────────────
# Emergency stop for the mobile app. Set to the lowest app build allowed, then
# REDEPLOY — env changes do not take effect until you do. Any app sending a lower
# X-App-Version gets 426 and a no-dismiss upgrade wall.
# Leave UNSET in normal operation; unset (or malformed) means the gate is off.
# /api/health and /api/ready are always exempt, as are callers with no version.
MIN_MOBILE_VERSION="1.2.0"                              # Unset = gate disabled

# ── Deep Links (Universal / App Links) ────────────────────────────────────────
# Until these are set, /.well-known/apple-app-site-association and
# /.well-known/assetlinks.json return 404 and links open the browser, not the app.
# Both files must be served from the apex AND www with no redirect.
APPLE_TEAM_ID="..."                                     # Apple Developer → Membership
APPLE_BUNDLE_IDS="net.gameground.redesigned"            # Comma-separated. NOT net.gameground.app
ANDROID_PACKAGE_NAME="net.gameground.redesigned"
ANDROID_CERT_SHA256="..."                               # RELEASE key from `eas credentials` — not debug

# ── Ops Alerts ────────────────────────────────────────────────────────────────
# Where admin alerts and the daily digest land. Comma-separated, so the whole ops
# team gets one alert with no distribution list to maintain. Each address is sent
# its own copy, so replies don't expose the team's addresses to each other.
# UNSET = no-op: alerts are logged and dropped, and nothing breaks. Every event is
# still recorded in OpsEvent, so setting this later loses no history — only the
# undelivered backlog, which the hourly dispatch-ops cron then drains.
ADMIN_EMAIL="ops@gameground.net,you@gameground.net"

# ── Also read by the app (optional unless the feature is used) ────────────────
ADMIN_JWT_SECRET=""                    # Separate signing secret for the admin cookie; falls back to AUTH_SECRET
MOBILE_APP_SCHEME="ggredesign"         # Deep-link scheme the mobile OAuth handoff redirects to
COACH_AUTO_COMPLETE_DAYS="30"          # Days after approval before a coach booking auto-completes
EXPO_ACCESS_TOKEN=""                   # Expo push service token (mobile push)
GOOGLE_IOS_CLIENT_ID=""                # Google Sign-In audiences for the mobile apps
GOOGLE_ANDROID_CLIENT_ID=""
GOOGLE_SITE_VERIFICATION=""            # Search Console HTML-tag token
NEXT_PUBLIC_POSTHOG_HOST=""            # Override the PostHog ingest host (defaults to /ingest rewrite)
